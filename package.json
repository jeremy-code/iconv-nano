{
  "name": "iconv-nano",
  "version": "0.0.22",
  "description": "Tree-shakable ESM iconv-lite for encoding and decoding",
  "keywords": [
    "encoding",
    "iconv",
    "icu",
    "unicode",
    "utf-8"
  ],
  "homepage": "https://github.com/jeremy-code/iconv-nano#readme",
  "bugs": "https://github.com/jeremy-code/iconv-nano/issues",
  "license": "BSD-2-Clause",
  "author": "Jeremy Nguyen <hi@jeremy.ng> (https://jeremy.ng/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeremy-code/iconv-nano.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate-encodings": "node --import @oxc-node/core/register ./scripts/generate-encodings.ts",
    "ci:publish": "./scripts/publish.sh"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@oxc-node/core": "^1.0.1",
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "lefthook": "^2.2.1",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "publint": "^0.3.25",
    "rolldown": "^1.2.16",
    "tsdown": "^0.23.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=11.0.0"
  }
}
